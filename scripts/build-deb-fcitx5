#!/bin/sh
# build-deb-fcitx5 — đóng gói addon Fcitx5 thành .deb riêng (gói onikey chính
# dùng IBus, không nên bắt người dùng IBus kéo theo cả fcitx5).
set -e
cd "$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

BASE=$(grep -m1 '^version=' Makefile | cut -d= -f2)
GITD=$(git show -s --format=%cd --date=format:'%Y%m%d%H%M%S' HEAD 2>/dev/null || echo 0)
GITH=$(git rev-parse --short HEAD 2>/dev/null || echo local)
VERSION="${BASE}+git${GITD}.${GITH}"
ARCH=$(dpkg --print-architecture)
PKG=fcitx5-onikey

# addon phải build sẵn: cargo build --release -p onikey-core-ffi && cmake ...
test -f fcitx5/build/onikey.so || { echo "chưa có fcitx5/build/onikey.so"; exit 1; }

STAGE=$(mktemp -d)
trap 'rm -rf "$STAGE"' EXIT

install -Dm755 fcitx5/build/onikey.so "$STAGE/usr/lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH)/fcitx5/onikey.so"
install -Dm644 fcitx5/onikey-addon.conf "$STAGE/usr/share/fcitx5/addon/onikey.conf"
install -Dm644 fcitx5/inputmethod/onikey.conf "$STAGE/usr/share/fcitx5/inputmethod/onikey.conf"

mkdir -p "$STAGE/DEBIAN"
cat > "$STAGE/DEBIAN/control" <<CTRL
Package: $PKG
Version: $VERSION
Architecture: $ARCH
Maintainer: xtcrust <xtczone000000@gmail.com>
Section: utils
Priority: optional
Depends: fcitx5
Homepage: https://github.com/xtcrust/Onikey
Description: Onikey Vietnamese input method - Fcitx5 addon
 Vietnamese input engine (Rust core) as a Fcitx5 addon, for KDE and
 distributions that do not use IBus.
CTRL

OUT="$(pwd)/${PKG}_${VERSION}_${ARCH}.deb"
dpkg-deb --build --root-owner-group "$STAGE" "$OUT" >/dev/null
echo "$OUT"
