pkgname=onikey
pkgver=1.0.0
pkgrel=1
pkgdesc='Bộ gõ tiếng Việt cho IBus, không gạch chân khi gõ (fork của ibus-bamboo)'
arch=('x86_64' 'aarch64')
license=(GPL3)
url="https://github.com/xtcrust/Onikey"
depends=('ibus' 'gtk3' 'libx11' 'libxtst')
makedepends=('go' 'gcc' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz"::"$url/archive/v$pkgver.tar.gz")
md5sums=('SKIP')
options=('!strip')
conflicts=(onikey-git)

build() {
  cd "$pkgname-$pkgver"

  make build PREFIX=/usr
}


package() {
  cd "$pkgname-$pkgver"

  make install PREFIX=/usr DESTDIR="$pkgdir/"
}
