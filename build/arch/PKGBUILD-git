pkgname=onikey-git
pkgver=0.9.0
pkgrel=2
pkgdesc='Bộ gõ tiếng Việt cho IBus, không gạch chân khi gõ (fork của ibus-bamboo)'
arch=('x86_64' 'aarch64')
license=(GPL3)
url="https://github.com/xtcrust/Onikey"
depends=('ibus' 'gtk3' 'libx11' 'libxtst')
makedepends=('go' 'gcc' 'pkgconf')
source=("$pkgname"::git+"$url")
md5sums=('SKIP')
options=('!strip')
conflicts=(onikey)


build() {
  cd "$pkgname"

  make build PREFIX=/usr
}


package() {
  cd "$pkgname"

  make PREFIX="/usr" DESTDIR="$pkgdir/" install
}
