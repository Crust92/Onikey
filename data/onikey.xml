<component>
    <name>org.freedesktop.IBus.Onikey</name>
    <description>Vietnamese input engine for IBus</description>
    <exec>/usr/lib/onikey/onikey-engine --ibus</exec>
    <version>0.9.0</version>
    <author>Luong Thanh Lam &lt;ltlam93@gmail.com&gt;</author>
    <license>GPLv3</license>
    <homepage>https://github.com/xtcrust/Onikey</homepage>
    <textdomain>onikey</textdomain>
    <engines>
          <engine>
              <symbol>vi</symbol>
              <name>Onikey</name>
              <language>vi</language>
              <license>GPLv3</license>
              <author>Luong Thanh Lam &lt;ltlam93@gmail.com&gt;</author>
              <icon>/usr/share/onikey/icons/vi.svg</icon>
              <layout>default</layout>
              <longname>Onikey</longname>
              <description>Vietnamese input method editor</description>
              <setup>/usr/lib/onikey/onikey-engine -gui</setup>
              <rank>1</rank>
          </engine>
          <engine>
              <symbol>vi</symbol>
              <name>Onikey::Us</name>
              <language>vi</language>
              <license>GPLv3</license>
              <author>Luong Thanh Lam &lt;ltlam93@gmail.com&gt;</author>
              <icon>/usr/share/onikey/icons/vi.svg</icon>
              <layout>us</layout>
              <longname>Onikey (US layout)</longname>
              <description>Vietnamese input method editor with US keyboard layout</description>
              <rank>1</rank>
              <setup>/usr/lib/onikey/onikey-engine -gui</setup>
          </engine>
	  <!-- Vietnamese Icons -->
          <engine>
              <symbol>vi</symbol>
              <name>Onikey::Candy</name>
              <language>vi</language>
              <license>GPLv3</license>
              <author>Tran Duc Binh &lt;binhtran432k@gmail.com&gt;</author>
              <icon>/usr/share/onikey/icons/vi-candy.svg</icon>
              <layout>default</layout>
              <longname>Onikey Candy</longname>
              <description>Vietnamese input method editor with US keyboard layout with Candy Icon</description>
              <rank>1</rank>
              <setup>/usr/lib/onikey/onikey-engine -gui</setup>
          </engine>
          <engine>
              <symbol>vi</symbol>
              <name>Onikey::Flag</name>
              <language>vi</language>
              <license>GPLv3</license>
              <author>Tran Duc Binh &lt;binhtran432k@gmail.com&gt;</author>
              <icon>/usr/share/onikey/icons/vi-flag.svg</icon>
              <layout>default</layout>
              <longname>Onikey Flag</longname>
              <description>Vietnamese input method editor with US keyboard layout with Flag Icon</description>
              <rank>1</rank>
              <setup>/usr/lib/onikey/onikey-engine -gui</setup>
          </engine>
	  <!-- English (US) Icons -->
          <engine>
              <symbol>en</symbol>
              <name>OnikeyUs</name>
              <language>en</language>
              <license>GPLv3</license>
              <author>Tran Duc Binh &lt;binhtran432k@gmail.com&gt;</author>
              <icon>/usr/share/onikey/icons/us.svg</icon>
              <layout>us</layout>
              <longname>Onikey English (US)</longname>
              <description>Vietnamese input method editor with US keyboard layout with US Normal Icon</description>
              <rank>2</rank>
              <setup>/usr/lib/onikey/onikey-engine -gui</setup>
          </engine>
          <engine>
              <symbol>en</symbol>
              <name>OnikeyUs::Candy</name>
              <language>en</language>
              <license>GPLv3</license>
              <author>Tran Duc Binh &lt;binhtran432k@gmail.com&gt;</author>
